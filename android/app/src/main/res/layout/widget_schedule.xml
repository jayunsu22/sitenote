<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 전체: 머리줄(제목·갱신시각·⟳) / 이번 주 띠 / 앞으로 현장 목록.
     앱 일정 화면 위쪽과 같은 모양이라 따로 익힐 게 없다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 현장 일정"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <!-- 다른 주를 보고 있을 때만 보인다. 누르면 이번 주로 -->
        <TextView
            android:id="@+id/thisWeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/cell_has"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="이번 주로"
            android:textColor="@color/sat"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/faint"
            android:textSize="11sp" />
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="새로고침"
            android:padding="6dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- 불러오기 실패·백업키 없음 같은 알림. 평소엔 숨긴다 -->
    <TextView
        android:id="@+id/notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingBottom="2dp"
        android:textColor="@color/danger"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- 주 넘기기: 안드로이드 위젯은 스와이프를 못 받는다 (시스템이 탭만 넘겨준다).
         그래서 띠 양옆을 누르는 칸으로 둔다. 손가락이 닿기 쉽게 띠 높이만큼 크게 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
    <TextView
        android:id="@+id/prevWeek"
        android:layout_width="28dp"
        android:layout_height="64dp"
        android:contentDescription="지난 주"
        android:gravity="center"
        android:text="‹"
        android:textColor="@color/muted"
        android:textSize="26sp" />
    <LinearLayout
        android:id="@+id/week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/cell0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/wd0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/dn0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ct0"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cell1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/wd1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/dn1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ct1"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cell2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/wd2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/dn2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ct2"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cell3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/wd3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/dn3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ct3"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cell4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/wd4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/dn4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ct4"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cell5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/wd5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/dn5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ct5"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cell6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="1.5dp"
            android:layout_marginEnd="1.5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/wd6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/dn6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/ct6"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/nextWeek"
        android:layout_width="28dp"
        android:layout_height="64dp"
        android:contentDescription="다음 주"
        android:gravity="center"
        android:text="›"
        android:textColor="@color/muted"
        android:textSize="26sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="앞으로 잡힌 일정이 없습니다"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>

    {
      "id": "0e074583-4e88-484b-bce2-1311b1c80d50",
      "name": "복원 합치기",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        320
      ],
      "parameters": {
        "jsCode": "\n// 3개 테이블 결과를 앱이 기대하는 형태로 합침\nfunction rows(nodeName) {\n  const out = [];\n  for (const it of $(nodeName).all()) {\n    const recs = (it.json.records) ? it.json.records : [];\n    for (const r of recs) {\n      const f = r.fields || {};\n      if (f['삭제']) continue;\n      try { out.push(JSON.parse(f.data || '{}')); } catch (e) { /* 손상된 행 무시 */ }\n    }\n  }\n  return out;\n}\nconst clients = rows('거래처 읽기');\nconst sites = rows('현장 읽기');\nconst photos = rows('사진 읽기');\nconst settingsRows = rows('설정 읽기');\nreturn [{ json: { clients, sites, photos, settings: settingsRows[0] || {} } }];\n"
      }
    },
